DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apexnova
JWT_SECRET=
PORT=4000
CORS_ORIGINS=http://localhost:3000,https://rajtivari.github.io
TRUST_PROXY=false

# Optional additional guard for pre-provisioned super-admin accounts (never grants roles by itself)
ADMIN_EMAILS=admin@apexnova.in,owner@apexnova.in
# Used by the admin:create script to provision one super-admin account
ADMIN_EMAIL=admin@apexnova.in
ADMIN_DISPLAY_NAME=APEX NOVA OWNER
ADMIN_PASSWORD=

# Manual UPI entry confirmation stays off until legal registration and the owner QR are configured.
PAYMENTS_ENABLED=false
ESPORTS_REGISTRATION_ID=
UPI_QR_URL=

# Aadhaar image checks stay off until OVSE registration and encrypted persistent storage are configured.
KYC_UPLOADS_ENABLED=false
UIDAI_OVSE_ID=
KYC_PRIVATE_STORAGE_DIR=/var/lib/apexnova/kyc
DATA_ENCRYPTION_KEY=
